{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "燕云琴笺",
  "version": "0.1.7",
  "identifier": "io.github.migo-ovo.yysls-auto-guqin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "燕云琴笺",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#eeeae2",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com"
    }
  },
  "bundle": {
    "licenseFile": "../LICENSE",
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "燕云十六声自由演奏与乐谱编排",
    "copyright": "Copyright © 2026 Kukisama and MIGO-OvO",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczM0UzN0U5QTAwMzlEMzcKUldRM25RT2c2VGMrYzY0Nnp5TVNFYXFLOEI4Q3NobTRXUkZlMlJTa1IvYzFoWDVsY1hnMzBXTU4K",
      "endpoints": [
        "https://github.com/MIGO-OvO/yysls-auto-guqin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
