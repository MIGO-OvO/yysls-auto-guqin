{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主工作台窗口权限",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-start-dragging", "dialog:allow-open", "dialog:allow-save", "fs:allow-read-file", "fs:allow-write-text-file", "fs:allow-write-file", "updater:default", "process:allow-restart"]
}
