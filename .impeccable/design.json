  "components": [
    {
      "name": "主要按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "开始演奏与保存等主要动作。",
      "html": "<button class=\"ds-button-primary\">向游戏演奏</button>",
      "css": ".ds-button-primary{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--gold);color:var(--bg);border-radius:5px;padding:10px 16px;font-weight:600;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-primary:hover{filter:brightness(1.1)}.ds-button-primary:focus-visible{outline:2px solid var(--gold);outline-offset:2px}.ds-button-primary:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "次要按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "检测与应用设置。",
      "html": "<button class=\"ds-button-secondary\">重新检测</button>",
      "css": ".ds-button-secondary{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:4px;padding:8px 11px;font-size:11px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-secondary:hover:not(:disabled){background:var(--surface-hover);border-color:var(--subtle)}.ds-button-secondary:focus-visible{outline:2px solid var(--gold);outline-offset:2px}.ds-button-secondary:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
    {
      "name": "轻按钮",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "标题区工具动作。",
      "html": "<button class=\"ds-button-quiet\">导出</button>",
      "css": ".ds-button-quiet{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:transparent;color:var(--muted);border-radius:4px;padding:7px 9px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-quiet:hover:not(:disabled){background:var(--surface-hover);color:var(--text)}.ds-button-quiet:focus-visible{outline:2px solid var(--gold);outline-offset:2px}.ds-button-quiet:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-quiet{transition:none}}"
    },
    {
