    {
      "name": "图标按钮",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "新建曲谱等具名图标动作。",
      "html": "<button class=\"ds-button-icon\" aria-label=\"新建曲谱\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg></button>",
      "css": ".ds-button-icon{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:transparent;color:var(--muted);border-radius:4px;padding:0;width:30px;height:30px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-icon:hover:not(:disabled){background:var(--surface-hover);color:var(--text)}.ds-button-icon:focus-visible{outline:2px solid var(--gold);outline-offset:2px}.ds-button-icon:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-icon{transition:none}}.ds-button-icon.ds-active{background:var(--surface-hover);color:var(--gold)}"
    },
