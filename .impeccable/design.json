  "components": [
    {
      "name": "主要按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "开始演奏与保存等主要动作。",
      "html": "<button class=\"ds-button-primary\">向游戏演奏</button>",
      "css": ".ds-button-primary{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--accent);color:var(--on-accent);border-radius:5px;padding:10px 16px;font-weight:600;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-primary:hover{filter:brightness(1.1)}.ds-button-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-button-primary:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "次要按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "检测与应用设置。",
      "html": "<button class=\"ds-button-secondary\">重新检测</button>",
      "css": ".ds-button-secondary{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:4px;padding:8px 11px;font-size:11px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-secondary:hover:not(:disabled){background:var(--surface-hover);border-color:var(--subtle)}.ds-button-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-button-secondary:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
    {
      "name": "轻按钮",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "标题区工具动作。",
      "html": "<button class=\"ds-button-quiet\">导出</button>",
      "css": ".ds-button-quiet{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:transparent;color:var(--muted);border-radius:4px;padding:7px 9px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-quiet:hover:not(:disabled){background:var(--surface-hover);color:var(--text)}.ds-button-quiet:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-button-quiet:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-quiet{transition:none}}"
    },
    {
      "name": "删除按钮",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "确认删除曲谱。",
      "html": "<button class=\"ds-button-danger\">删除曲谱</button>",
      "css": ".ds-button-danger{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--red);color:var(--bg);border-radius:4px;padding:9px 14px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-danger:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-button-danger:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none}}"
    },
    {
      "name": "试听按钮",
      "kind": "button",
      "refersTo": "button-preview",
      "description": "试听、暂停与继续。",
      "html": "<button class=\"ds-button-preview\">试听</button>",
      "css": ".ds-button-preview{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--surface);color:var(--text);border-radius:5px;padding:8px 11px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-preview:hover{background:var(--surface-hover)}.ds-button-preview:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-button-preview:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-preview{transition:none}}.ds-button-preview.ds-active{background:var(--surface-hover)}"
    },
    {
      "name": "图标按钮",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "新建曲谱等具名图标动作。",
      "html": "<button class=\"ds-button-icon\" aria-label=\"新建曲谱\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg></button>",
      "css": ".ds-button-icon{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:transparent;color:var(--muted);border-radius:4px;padding:0;width:30px;height:30px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-icon:hover:not(:disabled){background:var(--surface-hover);color:var(--text)}.ds-button-icon:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-button-icon:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-icon{transition:none}}.ds-button-icon.ds-active{background:var(--surface-hover);color:var(--accent)}"
    },
    {
      "name": "音符字段",
      "kind": "input",
      "refersTo": "input-field",
      "description": "音高、位置与音长等字段。",
      "html": "<input class=\"ds-input-field\" aria-label=\"所选位置\" value=\"1\" />",
      "css": ".ds-input-field{font:inherit;font-size:11px;color:var(--text);background:var(--canvas);border:1px solid var(--line);border-radius:4px;padding:7px;caret-color:var(--accent);outline:none;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-input-field:focus{border-color:var(--accent)}@media(prefers-reduced-motion:reduce){.ds-input-field{transition:none}}"
    },
    {
      "name": "面板标签",
      "kind": "nav",
      "refersTo": "nav-tab",
      "description": "演奏与设置共享面板。",
      "html": "<nav class=\"ds-nav-tabs\" aria-label=\"面板\"><button class=\"ds-nav-tab ds-selected\" aria-current=\"page\">演奏</button><button class=\"ds-nav-tab\">设置</button></nav>",
      "css": ".ds-nav-tabs{display:flex;gap:21px;height:62px}.ds-nav-tab{font:inherit;font-size:12px;color:var(--muted);border:0;border-bottom:2px solid transparent;background:transparent;padding:2px 0 0;cursor:pointer;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-nav-tab.ds-selected{color:var(--accent);border-bottom-color:var(--accent)}.ds-nav-tab:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-nav-tab{transition:none}}"
    },
    {
      "name": "对话框",
      "kind": "card",
      "refersTo": "dialog",
      "description": "导入、导出与确认操作。",
      "html": "<section class=\"ds-dialog\" aria-label=\"导入曲谱\"><header>导入曲谱</header><div>简谱、MIDI、JSON 或 TXT</div></section>",
      "css": ".ds-dialog{color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:10px;width:420px;max-width:calc(100vw - 40px);box-shadow:var(--shadow)}.ds-dialog header{padding:17px 22px;border-bottom:1px solid var(--line);font-family:\"Noto Serif SC\",serif;font-size:16px;font-weight:600}.ds-dialog>div{padding:23px;font-size:12px;line-height:1.9}"
    },
    {
      "name": "钢琴卷音符",
      "kind": "custom",
      "refersTo": "roll-note-mid",
      "description": "宽度对应时长，分音区使用不同背景。",
      "html": "<button class=\"ds-roll-note\" aria-label=\"音符 1 第1格\" aria-pressed=\"false\"><span>1</span></button>",
      "css": ".ds-roll-note{position:relative;display:flex;align-items:center;width:82px;height:16px;border:0;border-radius:3px;padding:0 6px;overflow:hidden;background:var(--note-mid);color:var(--note-text);cursor:grab;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-roll-note span{font-family:\"Microsoft YaHei UI\", \"PingFang SC\", \"Noto Sans CJK SC\", sans-serif;font-size:9px;font-weight:600;white-space:nowrap}.ds-roll-note:hover{filter:brightness(0.92)}.ds-roll-note[aria-pressed=\"true\"]{outline:1px solid var(--text);outline-offset:1px}.ds-roll-note:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-roll-note{transition:none}}.ds-roll-note.ds-low{background:var(--note-low)}.ds-roll-note.ds-high{background:var(--note-high)}.ds-roll-note.ds-command{background:var(--accent)}.ds-roll-note.ds-sounding{background:var(--note-active)}"
    }
  ],
