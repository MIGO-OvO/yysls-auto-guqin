      "html": "<button class=\"ds-button-danger\">删除曲谱</button>",
      "css": ".ds-button-danger{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--red);color:var(--bg);border-radius:4px;padding:9px 14px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-danger:focus-visible{outline:2px solid var(--gold);outline-offset:2px}.ds-button-danger:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none}}"
    },
    {
      "name": "试听按钮",
      "kind": "button",
      "refersTo": "button-preview",
      "description": "试听、暂停与继续。",
      "html": "<button class=\"ds-button-preview\">试听</button>",
      "css": ".ds-button-preview{font:inherit;border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:var(--surface);color:var(--text);border-radius:5px;padding:8px 11px;transition:background-color 140ms,color 140ms,border-color 140ms;}.ds-button-preview:hover{background:var(--surface-hover)}.ds-button-preview:focus-visible{outline:2px solid var(--gold);outline-offset:2px}.ds-button-preview:disabled{opacity:.4;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-preview{transition:none}}.ds-button-preview.ds-active{background:var(--surface-hover)}"
